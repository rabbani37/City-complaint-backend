model StaffProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  name    String
  email   String  @unique
  address String?
  nid     String

  image_url     String?
  imagePublicId String?

  experienceYears Int
  expertise       String
  abouts          String?

  approvedById   String?
  approvedPerson AdminProfile? @relation(fields: [approvedById], references: [id], onDelete: Cascade, onUpdate: Cascade)

  approvedAt DateTime?

  departmentId String    
  department   Department @relation(fields: [departmentId], references: [id])

  taskAssigned TaskAssigned[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_profiles")
}
