model Complaint {
  id          String  @id @default(uuid())
  title       String
  description String
  location    String

  latitude        Float?
  longitude       Float?
  status          ComplaintStatus @default(PENDING)
  complaintImages Json?

  citizenId  String
  citizen    CitizenProfile @relation(fields: [citizenId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  taskAssigned TaskAssigned[]
  feedback     Feedback?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([citizenId])
  @@index([categoryId])
  @@map("complaints")
}
