
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f4f7fb; padding: 40px 15px;">

        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                    max-width: 600px;
                    background-color: #ffffff;
                    border-radius: 16px;
                    overflow: hidden;
                    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
                ">

                    <!-- Header -->
                    <tr>
                        <td style="
                            background: linear-gradient(135deg, #16a34a, #15803d);
                            padding: 32px 35px;
                            text-align: center;
                        ">

                            <div style="
                                display: inline-block;
                                width: 56px;
                                height: 56px;
                                line-height: 56px;
                                background-color: rgba(255,255,255,0.15);
                                border-radius: 50%;
                                font-size: 28px;
                                color: #ffffff;
                            ">
                                ✓
                            </div>

                            <h1 style="
                                margin: 18px 0 0;
                                color: #ffffff;
                                font-size: 26px;
                                font-weight: 700;
                            ">
                                Password Reset Successful
                            </h1>

                            <p style="
                                margin: 10px 0 0;
                                color: #dcfce7;
                                font-size: 14px;
                            ">
                                Your Citizen account password has been changed successfully
                            </p>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 38px 40px;">

                            <p style="
                                margin: 0 0 18px;
                                font-size: 16px;
                                line-height: 1.7;
                            ">
                                Hello <strong><%= Name %></strong>,
                            </p>

                            <p style="
                                margin: 0 0 24px;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                This is a confirmation that the password for your
                                Citizen account has been successfully changed.
                            </p>

                            <!-- Account Information -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                                background-color: #f8fafc;
                                border: 1px solid #e5e7eb;
                                border-radius: 10px;
                                margin-bottom: 28px;
                            ">

                                <tr>
                                    <td style="
                                        padding: 14px 18px;
                                        font-size: 13px;
                                        color: #6b7280;
                                        width: 35%;
                                    ">
                                        Account Email
                                    </td>

                                    <td style="
                                        padding: 14px 18px;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #111827;
                                        word-break: break-word;
                                    ">
                                        <%= Email %>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="
                                        padding: 14px 18px;
                                        font-size: 13px;
                                        color: #6b7280;
                                    ">
                                        Status
                                    </td>

                                    <td style="
                                        padding: 14px 18px;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #16a34a;
                                    ">
                                        Password Changed Successfully
                                    </td>
                                </tr>

                            </table>

                            <!-- Success Message -->
                            <div style="
                                text-align: center;
                                background-color: #f0fdf4;
                                border: 1px solid #bbf7d0;
                                border-radius: 12px;
                                padding: 25px 20px;
                                margin-bottom: 25px;
                            ">

                                <div style="
                                    display: inline-block;
                                    width: 48px;
                                    height: 48px;
                                    line-height: 48px;
                                    background-color: #dcfce7;
                                    border-radius: 50%;
                                    color: #16a34a;
                                    font-size: 24px;
                                    font-weight: 700;
                                    margin-bottom: 12px;
                                ">
                                    ✓
                                </div>

                                <p style="
                                    margin: 0;
                                    color: #166534;
                                    font-size: 15px;
                                    font-weight: 600;
                                ">
                                    Your password has been successfully updated.
                                </p>

                            </div>

                            <!-- Security Notice -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                                background-color: #fff7ed;
                                border-left: 4px solid #f97316;
                                margin-bottom: 28px;
                            ">

                                <tr>
                                    <td style="padding: 14px 16px;">

                                        <p style="
                                            margin: 0 0 5px;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: #9a3412;
                                        ">
                                            🔒 Security Notice
                                        </p>

                                        <p style="
                                            margin: 0;
                                            font-size: 12px;
                                            line-height: 1.6;
                                            color: #7c2d12;
                                        ">
                                            If you did not make this password change,
                                            please contact our support team immediately
                                            and secure your account.
                                        </p>

                                    </td>
                                </tr>

                            </table>

                            <p style="
                                margin: 0;
                                font-size: 14px;
                                line-height: 1.7;
                                color: #4b5563;
                            ">
                                You can now use your new password to sign in to
                                your Citizen account.
                            </p>

                            <p style="
                                margin: 28px 0 0;
                                font-size: 14px;
                                line-height: 1.7;
                                color: #374151;
                            ">
                                Best regards,<br />
                                <strong>Citizen Team</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="
                            background-color: #f8fafc;
                            border-top: 1px solid #e5e7eb;
                            padding: 24px 35px;
                            text-align: center;
                        ">

                            <p style="
                                margin: 0 0 8px;
                                font-size: 12px;
                                color: #6b7280;
                            ">
                                <%= new Date().getFullYear() %> Citizen.
                                All rights reserved.
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 11px;
                                color: #9ca3af;
                                line-height: 1.5;
                            ">
                                This is an automated email. Please do not reply
                                to this message.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>

</html>
